---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PerformerCard from '../../components/PerformerCard.astro';
import { getPage, getEvents, getPerformers } from '../../lib/content';

const page = await getPage('performers');
const { upcoming, past } = await getEvents();
const all = await getPerformers();
const groups = [...upcoming, ...past]
  .map((e) => ({ event: e, performers: all.filter((p) => p.data.events.includes(e.id)) }))
  .filter((g) => g.performers.length > 0);
---

<Layout title="Performers" description={page.data.intro}>
  <PageHeader eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro} />
  {
    groups.map((g) => (
      <section class="section" style="padding-top: 24px;">
        <div class="container">
          <div class="section-head">
            <h2>{g.event.data.title}</h2>
            {g.event.data.status === 'past' && (
              <a class="more-link" href={`/past-events/${g.event.id}/`}>
                Photos →
              </a>
            )}
          </div>
          <div class="grid">
            {g.performers.map((p) => (
              <PerformerCard performer={p} />
            ))}
          </div>
        </div>
      </section>
    ))
  }
  {
    groups.length === 0 && (
      <section class="section">
        <div class="container">
          <p class="lead">The lineup will be announced soon.</p>
        </div>
      </section>
    )
  }
</Layout>
