---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getPage, getEvents, eventWhen } from '../lib/content';

const page = await getPage('tickets');
const { Content } = await render(page);
const { current, latestPast } = await getEvents();
const ev = current;
const onSale = !!(ev?.data.ticketsOnSale && ev.data.tixfoxUrl);
const policies = ev?.data.ticketPolicies.length ? ev.data.ticketPolicies : (latestPast?.data.ticketPolicies ?? []);
---

<Layout title="Tickets" description={page.data.intro}>
  <PageHeader eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro}>
    {
      ev && (
        <p style="margin-top: 16px; font-weight: 700;">
          {ev.data.title} · {eventWhen(ev)}
          {ev.data.venue && ` · ${ev.data.venue}`}
          {ev.data.time && ` · ${ev.data.time}`}
        </p>
      )
    }
  </PageHeader>

  <section class="section" style="padding-top: 24px;">
    <div class="container stack" style="gap: 32px;">
      {
        onSale ? (
          <>
            <div class="grid-2">
              {ev!.data.ticketTiers.map((t) => (
                <article class="card tier">
                  <span class="eyebrow">{t.name}</span>
                  <span class="tier-price">{t.price}</span>
                  {t.note && <p style="color: var(--muted)">{t.note}</p>}
                  {t.includes.length > 0 && (
                    <ul>
                      {t.includes.map((i) => (
                        <li>{i}</li>
                      ))}
                    </ul>
                  )}
                </article>
              ))}
            </div>
            <div class="btn-row">
              <a class="btn btn-primary" href={ev!.data.tixfoxUrl}>
                Buy tickets on TixFox
              </a>
            </div>
          </>
        ) : (
          <div class="prose">
            <Content />
          </div>
        )
      }

      {
        policies.length > 0 && (
          <div class="stack" style="gap: 8px;">
            <h2 style="font-size: 1.6rem;">Good to know</h2>
            <ul class="prose" style="padding-left: 1.2em; margin: 0;">
              {policies.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        !onSale && (
          <div class="btn-row">
            <a class="btn btn-primary" href="/audition/">
              Audition to perform
            </a>
            <a class="btn btn-secondary" href="/sponsors/#become-a-sponsor">
              Become a sponsor
            </a>
          </div>
        )
      }
    </div>
  </section>
</Layout>
