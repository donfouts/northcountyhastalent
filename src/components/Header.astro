---
import Wordmark from './Wordmark.astro';
import { getSettings } from '../lib/content';

const settings = await getSettings();
const links = [
  { href: '/performers/', label: 'Performers' },
  { href: '/tickets/', label: 'Tickets' },
  { href: '/sponsors/', label: 'Sponsors' },
  { href: '/past-events/', label: 'Past Events' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${settings.siteName} home`}>
      <Wordmark name={settings.siteName} />
    </a>

    <nav class="desktop-nav" aria-label="Main">
      <ul class="nav-links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li><a class="btn btn-primary btn-sm" href="/audition/">Audition</a></li>
      </ul>
    </nav>

    <details class="mobile-nav">
      <summary class="btn btn-secondary btn-sm">Menu</summary>
      <nav aria-label="Main (mobile)">
        <ul class="nav-links">
          {
            links.map((l) => (
              <li>
                <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
          <li><a class="btn btn-primary" href="/audition/">Audition</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
