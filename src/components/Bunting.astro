---
// Summer Fair: a string of pennant flags across the top of the page.
const colors = ['#FF6B5B', '#FFC93C', '#1FA5A0'];
const flags = Array.from({ length: 40 }, (_, i) => colors[i % 3]);
---

<div class="bunting" aria-hidden="true">
  {
    flags.map((c) => (
      <svg width="34" height="30" viewBox="0 0 34 30">
        <path d="M0 0 L34 0 L17 28 Z" fill={c} />
      </svg>
    ))
  }
</div>

<style>
  .bunting {
    display: flex;
    justify-content: space-between;
    overflow: hidden;
    padding-inline: 12px;
    height: 30px;
  }
  .bunting svg {
    flex-shrink: 0;
  }
</style>
