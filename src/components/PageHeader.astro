---
import { themeName } from '../lib/theme';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class={`page-header ph-${themeName}`}>
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {intro && <p class="lead">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(40px, 6vw, 72px) clamp(24px, 4vw, 40px);
  }
  .page-header .lead {
    margin-top: 16px;
  }
  .ph-fair .container {
    background: var(--surface-2);
    border-radius: 32px;
    padding-block: clamp(28px, 4vw, 48px);
  }
  .ph-marquee {
    text-align: center;
    border-bottom: 2px solid var(--ink);
    background: var(--surface-2);
    padding-bottom: clamp(32px, 5vw, 56px);
  }
  .ph-marquee .lead {
    margin-inline: auto;
  }
</style>
